{
  "manifest_version": 3,
  "name": "BongChzzk",
  "version": "1.6.0",
  "description": "치지직 무한 버퍼링 자동 복구, 화질·선명한 화면 고정, 시청자 수 표시, 팔로잉 자동 새로고침, 방향키 이동 등을 제공합니다.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://chzzk.naver.com/*",
    "https://api.chzzk.naver.com/*",
    "https://api.github.com/*",
    "https://github.com/*",
    "https://objects.githubusercontent.com/*",
    "https://release-assets.githubusercontent.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chzzk.naver.com/*"
      ],
      "js": [
        "lib/quality.js",
        "lib/following.js",
        "lib/extras.js",
        "lib/watch.js",
        "lib/wide.js",
        "lib/player.js",
        "content.js",
        "content-following.js",
        "content-extras.js",
        "content-watch.js",
        "content-wide.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
