{
    "displayName": "BongChrome",
    "name": "bongchrome",
    "version": "1.0.0",
    "description": "치지직·디시인사이드 개선과 Gemini 페이지 번역을 하나로 합친 크롬 확장 프로그램",
    "homepage": "https://github.com/Baegovda/BongChrome",
    "repository": {
        "type": "git",
        "url": "https://github.com/Baegovda/BongChrome.git"
    },
    "bugs": {
        "url": "https://github.com/Baegovda/BongChrome/issues"
    },
    "license": "GPL-3.0-only",
    "author": "Baegovda (디시 모듈 원작: green1052)",
    "scripts": {
        "dev": "wxt",
        "dev:firefox": "wxt -b firefox",
        "build": "wxt build",
        "zip": "wxt zip",
        "test": "bun run test:dc && bun run test:js",
        "postinstall": "wxt prepare",
        "build:firefox": "wxt build -b firefox",
        "zip:firefox": "wxt zip -b firefox",
        "test:dc": "bun test src/core src/modules/settings-io.test.ts",
        "test:js": "node --test src/modules/chzzk/test/*.test.js src/modules/trans/test/*.test.js",
        "verify": "bun scripts/verify-build.ts"
    },
    "dependencies": {
        "vue": "^3.5.40"
    },
    "devDependencies": {
        "@types/bun": "^1.3.14",
        "@types/js-cookie": "^3.0.6",
        "@webext-core/messaging": "^4.0.0",
        "@wxt-dev/auto-icons": "^1.1.1",
        "@wxt-dev/module-vue": "^1.0.3",
        "@wxt-dev/webextension-polyfill": "^1.0.0",
        "js-cookie": "^3.0.8",
        "ky": "^2.0.2",
        "sass": "^1.102.0",
        "webextension-polyfill": "^0.12.0",
        "wxt": "^0.20.27"
    },
    "private": true
}
